{
  "name": "@adityareddy-dev/otel-cluster-metrics",
  "version": "0.1.0",
  "description": "Cumulative OpenTelemetry metrics from Node cluster workers through one Prometheus endpoint",
  "license": "Apache-2.0",
  "author": "Aditya Reddy",
  "repository": {
    "type": "git",
    "url": "https://github.com/adityareddy-dev/otel-cluster-metrics.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.cjs",
    "demo": "npm run build && node examples/two-workers.cjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/exporter-prometheus": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/core": "3.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/exporter-prometheus": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
